{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "https://docs.oraxen.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://docs.oraxen.com/:path*",
      "permanent": true
    }
  ]
}
